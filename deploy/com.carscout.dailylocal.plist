<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Denni beh VSECH portalu (Sauto/Sbazar/AutoScout24/Kleinanzeigen + Mobile.de)
  do lokalni DB - staci pak jednou za den otevrit dashboard (localhost:5173).
  Instalace (jednou):
    cp deploy/com.carscout.dailylocal.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.carscout.dailylocal.plist
  Log: /tmp/carscout-dailylocal.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carscout.dailylocal</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd ~/Car_scout/auto_scout &amp;&amp; source .venv/bin/activate &amp;&amp; python -m scripts.run_daily_local</string>
  </array>

  <!-- 08:15 rano - bezny provoz, IP nevypada podezrele -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/carscout-dailylocal.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/carscout-dailylocal.log</string>
</dict>
</plist>
