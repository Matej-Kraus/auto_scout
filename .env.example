# Lokalne staci nechat SQLite. V produkci Neon Postgres.
DATABASE_URL=sqlite:///local.db

# Telegram (z @BotFather + getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Prah pro alert: 0.10 = posli kdyz je inzerat >=10 % pod predikci
DEAL_THRESHOLD=0.10

# Posilat alerty na Telegram? false = jen loguj (dry run)
NOTIFY_ENABLED=false

# --- Email notifikace (zdarma napr. pres Gmail) ---
# EMAIL_ENABLED=true zapne posilani. SMTP pres Gmail: host smtp.gmail.com, port 587,
# user = tva gmail adresa, password = "App password" (Google ucet -> Security ->
# 2-Step Verification -> App passwords; NE bezne heslo). email_to muze byt vic
# adres oddelenych carkou.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Lokalne za firemni TLS proxy, ktera lame SSL? Pak SSL_VERIFY=false.
# V produkci (Actions/Vercel) nech true.
SSL_VERIFY=true

# Residential proxy pro mobile.de (Akamai blokuje datacentrove i bezne IP).
# Bez vyplnene proxy se mobile.de automaticky preskakuje. Format:
# SCRAPER_PROXY_URL=http://user:pass@host:port
SCRAPER_PROXY_URL=
